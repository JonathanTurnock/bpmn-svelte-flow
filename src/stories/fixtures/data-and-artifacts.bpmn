<?xml version="1.0" encoding="UTF-8"?>
<!--
  Data and artifacts — data object, collection data object, data input, data
  output and data store, wired with data input/output associations, plus a
  text annotation joined by an association and a group around the lot.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_DataArtifacts"
    targetNamespace="http://bpmn-svelte-flow/fixtures">

  <bpmn:category id="Category_1">
    <bpmn:categoryValue id="CategoryValue_1" value="Order fulfilment"/>
  </bpmn:category>

  <bpmn:process id="Process_DataArtifacts" isExecutable="false">

    <bpmn:ioSpecification id="IoSpec_1">
      <bpmn:dataInput id="DataInput_1" name="Customer file"/>
      <bpmn:dataOutput id="DataOutput_1" name="Shipping label"/>
    </bpmn:ioSpecification>

    <bpmn:dataObject id="DataObject_Order"/>
    <bpmn:dataObjectReference id="Data_Order" name="Order" dataObjectRef="DataObject_Order"/>
    <bpmn:dataObject id="DataObject_Items" isCollection="true"/>
    <bpmn:dataObjectReference id="Data_Items" name="Order items&#10;(collection)" dataObjectRef="DataObject_Items"/>
    <bpmn:dataStoreReference id="Store_Archive" name="Archive"/>

    <bpmn:startEvent id="Start_1" name="Order received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Prepare" name="Prepare order">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DIA_Order">
        <bpmn:sourceRef>Data_Order</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>

    <bpmn:serviceTask id="Task_Ship" name="Ship order">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DIA_Items">
        <bpmn:sourceRef>Data_Items</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_Archive">
        <bpmn:targetRef>Store_Archive</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_1" name="Order shipped">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Prepare"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Prepare" targetRef="Task_Ship"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Ship" targetRef="End_1"/>

    <bpmn:textAnnotation id="Annotation_1">
      <bpmn:text>Priority customers ship&#10;within 24 hours</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" associationDirection="None" sourceRef="Task_Ship" targetRef="Annotation_1"/>

    <bpmn:group id="Group_1" categoryValueRef="CategoryValue_1"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_DataArtifacts">
    <bpmndi:BPMNPlane id="Plane_DataArtifacts" bpmnElement="Process_DataArtifacts">

      <bpmndi:BPMNShape id="Group_1_di" bpmnElement="Group_1">
        <dc:Bounds x="60" y="60" width="940" height="420"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Data_Order_di" bpmnElement="Data_Order">
        <dc:Bounds x="140" y="110" width="36" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="108" y="164" width="100" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Data_Items_di" bpmnElement="Data_Items">
        <dc:Bounds x="340" y="110" width="36" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="308" y="164" width="100" height="26"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Store_Archive_di" bpmnElement="Store_Archive">
        <dc:Bounds x="620" y="110" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="595" y="164" width="100" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataInput_1_di" bpmnElement="DataInput_1">
        <dc:Bounds x="760" y="110" width="36" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="728" y="164" width="100" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataOutput_1_di" bpmnElement="DataOutput_1">
        <dc:Bounds x="880" y="110" width="36" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="848" y="164" width="100" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="120" y="262" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="88" y="304" width="100" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Prepare_di" bpmnElement="Task_Prepare">
        <dc:Bounds x="220" y="240" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Ship_di" bpmnElement="Task_Ship">
        <dc:Bounds x="440" y="240" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1">
        <dc:Bounds x="640" y="262" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="608" y="304" width="100" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_1_di" bpmnElement="Annotation_1">
        <dc:Bounds x="740" y="340" width="220" height="60"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="156" y="280"/>
        <di:waypoint x="220" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="320" y="280"/>
        <di:waypoint x="440" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="540" y="280"/>
        <di:waypoint x="640" y="280"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="DIA_Order_di" bpmnElement="DIA_Order">
        <di:waypoint x="176" y="135"/>
        <di:waypoint x="250" y="135"/>
        <di:waypoint x="250" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DIA_Items_di" bpmnElement="DIA_Items">
        <di:waypoint x="376" y="135"/>
        <di:waypoint x="470" y="135"/>
        <di:waypoint x="470" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_Archive_di" bpmnElement="DOA_Archive">
        <di:waypoint x="540" y="260"/>
        <di:waypoint x="580" y="260"/>
        <di:waypoint x="580" y="135"/>
        <di:waypoint x="620" y="135"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_1_di" bpmnElement="Assoc_1">
        <di:waypoint x="490" y="320"/>
        <di:waypoint x="490" y="370"/>
        <di:waypoint x="740" y="370"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

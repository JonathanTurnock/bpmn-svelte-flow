<?xml version="1.0" encoding="UTF-8"?>
<!--
  Quickstart — the smallest useful BPMN file: one start event, one task, an
  exclusive gateway with a default flow, and two end events.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_Quickstart"
    targetNamespace="http://bpmn-svelte-flow/fixtures">

  <bpmn:process id="Process_Quickstart" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Request received">
      <bpmn:outgoing>Flow_ToReview</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Review" name="Review request">
      <bpmn:incoming>Flow_ToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gw_Approved" name="Approved?" default="Flow_No">
      <bpmn:incoming>Flow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_Approved" name="Request approved">
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Rejected" name="Request rejected">
      <bpmn:incoming>Flow_No</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToReview" sourceRef="Start_1" targetRef="Task_Review"/>
    <bpmn:sequenceFlow id="Flow_ToGateway" sourceRef="Task_Review" targetRef="Gw_Approved"/>
    <bpmn:sequenceFlow id="Flow_Yes" name="yes" sourceRef="Gw_Approved" targetRef="End_Approved"/>
    <bpmn:sequenceFlow id="Flow_No" name="no" sourceRef="Gw_Approved" targetRef="End_Rejected"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_Quickstart">
    <bpmndi:BPMNPlane id="Plane_Quickstart" bpmnElement="Process_Quickstart">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="160" y="182" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="128" y="224" width="100" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review">
        <dc:Bounds x="250" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Approved_di" bpmnElement="Gw_Approved">
        <dc:Bounds x="420" y="175" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="400" y="152" width="90" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Approved_di" bpmnElement="End_Approved">
        <dc:Bounds x="560" y="182" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="528" y="224" width="100" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected">
        <dc:Bounds x="560" y="322" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="528" y="364" width="100" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_ToReview_di" bpmnElement="Flow_ToReview">
        <di:waypoint x="196" y="200"/>
        <di:waypoint x="250" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToGateway_di" bpmnElement="Flow_ToGateway">
        <di:waypoint x="350" y="200"/>
        <di:waypoint x="420" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes_di" bpmnElement="Flow_Yes">
        <di:waypoint x="470" y="200"/>
        <di:waypoint x="560" y="200"/>
        <bpmndi:BPMNLabel><dc:Bounds x="495" y="176" width="30" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No_di" bpmnElement="Flow_No">
        <di:waypoint x="445" y="225"/>
        <di:waypoint x="445" y="340"/>
        <di:waypoint x="560" y="340"/>
        <bpmndi:BPMNLabel><dc:Bounds x="454" y="268" width="30" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

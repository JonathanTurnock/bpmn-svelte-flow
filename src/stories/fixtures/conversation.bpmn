<?xml version="1.0" encoding="UTF-8"?>
<!--
  Conversation diagram — three black-box participants tied together by a
  conversation, a sub-conversation and a call conversation, all joined with
  conversation links (the spec's double line).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_Conversation"
    targetNamespace="http://bpmn-svelte-flow/fixtures">

  <bpmn:collaboration id="Collaboration_Conversation">
    <bpmn:participant id="P_Customer" name="Customer"/>
    <bpmn:participant id="P_Retailer" name="Retailer"/>
    <bpmn:participant id="P_Carrier" name="Carrier">
      <bpmn:participantMultiplicity maximum="4"/>
    </bpmn:participant>

    <bpmn:conversation id="Conv_Order" name="Place order">
      <bpmn:participantRef>P_Customer</bpmn:participantRef>
      <bpmn:participantRef>P_Retailer</bpmn:participantRef>
    </bpmn:conversation>
    <bpmn:subConversation id="Conv_Shipment" name="Arrange shipment">
      <bpmn:participantRef>P_Retailer</bpmn:participantRef>
      <bpmn:participantRef>P_Carrier</bpmn:participantRef>
    </bpmn:subConversation>
    <bpmn:callConversation id="Conv_Payment" name="Settle payment">
      <bpmn:participantRef>P_Customer</bpmn:participantRef>
      <bpmn:participantRef>P_Retailer</bpmn:participantRef>
    </bpmn:callConversation>

    <bpmn:conversationLink id="Link_1" sourceRef="P_Customer" targetRef="Conv_Order"/>
    <bpmn:conversationLink id="Link_2" sourceRef="Conv_Order" targetRef="P_Retailer"/>
    <bpmn:conversationLink id="Link_3" sourceRef="P_Retailer" targetRef="Conv_Shipment"/>
    <bpmn:conversationLink id="Link_4" sourceRef="Conv_Shipment" targetRef="P_Carrier"/>
    <bpmn:conversationLink id="Link_5" sourceRef="P_Customer" targetRef="Conv_Payment"/>
    <bpmn:conversationLink id="Link_6" sourceRef="Conv_Payment" targetRef="P_Retailer"/>
  </bpmn:collaboration>

  <bpmndi:BPMNDiagram id="Diagram_Conversation">
    <bpmndi:BPMNPlane id="Plane_Conversation" bpmnElement="Collaboration_Conversation">
      <bpmndi:BPMNShape id="P_Customer_di" bpmnElement="P_Customer" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="180" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Retailer_di" bpmnElement="P_Retailer" isHorizontal="true">
        <dc:Bounds x="520" y="80" width="180" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Carrier_di" bpmnElement="P_Carrier" isHorizontal="true">
        <dc:Bounds x="920" y="80" width="180" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Conv_Order_di" bpmnElement="Conv_Order">
        <dc:Bounds x="350" y="240" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Conv_Shipment_di" bpmnElement="Conv_Shipment">
        <dc:Bounds x="750" y="240" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Conv_Payment_di" bpmnElement="Conv_Payment">
        <dc:Bounds x="350" y="420" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Link_1_di" bpmnElement="Link_1">
        <di:waypoint x="200" y="150"/>
        <di:waypoint x="200" y="280"/>
        <di:waypoint x="350" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Link_2_di" bpmnElement="Link_2">
        <di:waypoint x="450" y="280"/>
        <di:waypoint x="580" y="280"/>
        <di:waypoint x="580" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Link_3_di" bpmnElement="Link_3">
        <di:waypoint x="640" y="150"/>
        <di:waypoint x="640" y="280"/>
        <di:waypoint x="750" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Link_4_di" bpmnElement="Link_4">
        <di:waypoint x="850" y="280"/>
        <di:waypoint x="1010" y="280"/>
        <di:waypoint x="1010" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Link_5_di" bpmnElement="Link_5">
        <di:waypoint x="160" y="150"/>
        <di:waypoint x="160" y="460"/>
        <di:waypoint x="350" y="460"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Link_6_di" bpmnElement="Link_6">
        <di:waypoint x="450" y="460"/>
        <di:waypoint x="680" y="460"/>
        <di:waypoint x="680" y="150"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Event showcase — every BPMN 2.0 event shape, laid out in labelled rows:
  start, intermediate catch, intermediate throw, end, boundary (interrupting)
  and boundary (non-interrupting), across all event definitions.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_EventShowcase"
    targetNamespace="http://bpmn-svelte-flow/fixtures">

  <bpmn:process id="Process_EventShowcase" isExecutable="false">

    <!-- row headers -->
    <bpmn:textAnnotation id="Note_Start"><bpmn:text>Start events</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Catch"><bpmn:text>Intermediate catch</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Throw"><bpmn:text>Intermediate throw</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_End"><bpmn:text>End events</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_BoundaryI"><bpmn:text>Boundary&#10;(interrupting)</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_BoundaryN"><bpmn:text>Boundary&#10;(non-interrupting)</bpmn:text></bpmn:textAnnotation>

    <!-- row 1: start events -->
    <bpmn:startEvent id="S_None" name="None"/>
    <bpmn:startEvent id="S_Message" name="Message">
      <bpmn:messageEventDefinition id="S_Message_def"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="S_Timer" name="Timer">
      <bpmn:timerEventDefinition id="S_Timer_def"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="S_Conditional" name="Conditional">
      <bpmn:conditionalEventDefinition id="S_Conditional_def"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="S_Signal" name="Signal">
      <bpmn:signalEventDefinition id="S_Signal_def"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="S_Multiple" name="Multiple">
      <bpmn:messageEventDefinition id="S_Multiple_def1"/>
      <bpmn:signalEventDefinition id="S_Multiple_def2"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="S_ParallelMultiple" name="Parallel multiple" parallelMultiple="true">
      <bpmn:messageEventDefinition id="S_ParallelMultiple_def1"/>
      <bpmn:timerEventDefinition id="S_ParallelMultiple_def2"/>
    </bpmn:startEvent>

    <!-- row 2: intermediate catch events -->
    <bpmn:intermediateCatchEvent id="IC_Message" name="Message">
      <bpmn:messageEventDefinition id="IC_Message_def"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IC_Timer" name="Timer">
      <bpmn:timerEventDefinition id="IC_Timer_def"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IC_Conditional" name="Conditional">
      <bpmn:conditionalEventDefinition id="IC_Conditional_def"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IC_Link" name="Link (catch)">
      <bpmn:linkEventDefinition id="IC_Link_def" name="Hop"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IC_Signal" name="Signal">
      <bpmn:signalEventDefinition id="IC_Signal_def"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IC_Multiple" name="Multiple">
      <bpmn:messageEventDefinition id="IC_Multiple_def1"/>
      <bpmn:signalEventDefinition id="IC_Multiple_def2"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IC_ParallelMultiple" name="Parallel multiple" parallelMultiple="true">
      <bpmn:messageEventDefinition id="IC_ParallelMultiple_def1"/>
      <bpmn:timerEventDefinition id="IC_ParallelMultiple_def2"/>
    </bpmn:intermediateCatchEvent>

    <!-- row 3: intermediate throw events -->
    <bpmn:intermediateThrowEvent id="IT_None" name="None"/>
    <bpmn:intermediateThrowEvent id="IT_Message" name="Message">
      <bpmn:messageEventDefinition id="IT_Message_def"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="IT_Escalation" name="Escalation">
      <bpmn:escalationEventDefinition id="IT_Escalation_def"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="IT_Link" name="Link (throw)">
      <bpmn:linkEventDefinition id="IT_Link_def" name="Hop"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="IT_Compensation" name="Compensation">
      <bpmn:compensateEventDefinition id="IT_Compensation_def"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="IT_Signal" name="Signal">
      <bpmn:signalEventDefinition id="IT_Signal_def"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="IT_Multiple" name="Multiple">
      <bpmn:messageEventDefinition id="IT_Multiple_def1"/>
      <bpmn:escalationEventDefinition id="IT_Multiple_def2"/>
    </bpmn:intermediateThrowEvent>

    <!-- row 4: end events -->
    <bpmn:endEvent id="E_None" name="None"/>
    <bpmn:endEvent id="E_Message" name="Message">
      <bpmn:messageEventDefinition id="E_Message_def"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_Escalation" name="Escalation">
      <bpmn:escalationEventDefinition id="E_Escalation_def"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_Error" name="Error">
      <bpmn:errorEventDefinition id="E_Error_def"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_Cancel" name="Cancel">
      <bpmn:cancelEventDefinition id="E_Cancel_def"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_Compensation" name="Compensation">
      <bpmn:compensateEventDefinition id="E_Compensation_def"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_Signal" name="Signal">
      <bpmn:signalEventDefinition id="E_Signal_def"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_Terminate" name="Terminate">
      <bpmn:terminateEventDefinition id="E_Terminate_def"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_Multiple" name="Multiple">
      <bpmn:messageEventDefinition id="E_Multiple_def1"/>
      <bpmn:signalEventDefinition id="E_Multiple_def2"/>
    </bpmn:endEvent>

    <!-- row 5: interrupting boundary events on their hosts -->
    <bpmn:serviceTask id="Task_BI_Err" name="Charge card"/>
    <bpmn:boundaryEvent id="BI_Error" name="Error" attachedToRef="Task_BI_Err">
      <bpmn:errorEventDefinition id="BI_Error_def"/>
    </bpmn:boundaryEvent>

    <bpmn:transaction id="Tx_BI_Cancel" name="Book trip"/>
    <bpmn:boundaryEvent id="BI_Cancel" name="Cancel" attachedToRef="Tx_BI_Cancel">
      <bpmn:cancelEventDefinition id="BI_Cancel_def"/>
    </bpmn:boundaryEvent>

    <bpmn:task id="Task_BI_Comp" name="Reserve seat"/>
    <bpmn:boundaryEvent id="BI_Compensation" name="Compensation" attachedToRef="Task_BI_Comp">
      <bpmn:compensateEventDefinition id="BI_Compensation_def"/>
    </bpmn:boundaryEvent>

    <bpmn:userTask id="Task_BI_Msg" name="Await approval"/>
    <bpmn:boundaryEvent id="BI_Message" name="Message" attachedToRef="Task_BI_Msg">
      <bpmn:messageEventDefinition id="BI_Message_def"/>
    </bpmn:boundaryEvent>

    <bpmn:task id="Task_BI_Timer" name="Process order"/>
    <bpmn:boundaryEvent id="BI_Timer" name="Timer" attachedToRef="Task_BI_Timer">
      <bpmn:timerEventDefinition id="BI_Timer_def"/>
    </bpmn:boundaryEvent>

    <bpmn:task id="Task_BI_Esc" name="Handle case"/>
    <bpmn:boundaryEvent id="BI_Escalation" name="Escalation" attachedToRef="Task_BI_Esc">
      <bpmn:escalationEventDefinition id="BI_Escalation_def"/>
    </bpmn:boundaryEvent>

    <bpmn:scriptTask id="Task_BI_Sig" name="Run batch"/>
    <bpmn:boundaryEvent id="BI_Signal" name="Signal" attachedToRef="Task_BI_Sig">
      <bpmn:signalEventDefinition id="BI_Signal_def"/>
    </bpmn:boundaryEvent>

    <!-- row 6: non-interrupting boundary events on their hosts -->
    <bpmn:receiveTask id="Task_BN_Msg" name="Await goods"/>
    <bpmn:boundaryEvent id="BN_Message" name="Message" attachedToRef="Task_BN_Msg" cancelActivity="false">
      <bpmn:messageEventDefinition id="BN_Message_def"/>
    </bpmn:boundaryEvent>

    <bpmn:manualTask id="Task_BN_Timer" name="Assemble kit"/>
    <bpmn:boundaryEvent id="BN_Timer" name="Timer" attachedToRef="Task_BN_Timer" cancelActivity="false">
      <bpmn:timerEventDefinition id="BN_Timer_def"/>
    </bpmn:boundaryEvent>

    <bpmn:userTask id="Task_BN_Esc" name="Review case"/>
    <bpmn:boundaryEvent id="BN_Escalation" name="Escalation" attachedToRef="Task_BN_Esc" cancelActivity="false">
      <bpmn:escalationEventDefinition id="BN_Escalation_def"/>
    </bpmn:boundaryEvent>

    <bpmn:businessRuleTask id="Task_BN_Sig" name="Analyse data"/>
    <bpmn:boundaryEvent id="BN_Signal" name="Signal" attachedToRef="Task_BN_Sig" cancelActivity="false">
      <bpmn:signalEventDefinition id="BN_Signal_def"/>
    </bpmn:boundaryEvent>

    <bpmn:task id="Task_BN_Cond" name="Monitor line"/>
    <bpmn:boundaryEvent id="BN_Conditional" name="Conditional" attachedToRef="Task_BN_Cond" cancelActivity="false">
      <bpmn:conditionalEventDefinition id="BN_Conditional_def"/>
    </bpmn:boundaryEvent>

    <bpmn:sendTask id="Task_BN_Multi" name="Await events"/>
    <bpmn:boundaryEvent id="BN_Multiple" name="Multiple" attachedToRef="Task_BN_Multi" cancelActivity="false">
      <bpmn:messageEventDefinition id="BN_Multiple_def1"/>
      <bpmn:timerEventDefinition id="BN_Multiple_def2"/>
    </bpmn:boundaryEvent>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_EventShowcase">
    <bpmndi:BPMNPlane id="Plane_EventShowcase" bpmnElement="Process_EventShowcase">

      <bpmndi:BPMNShape id="Note_Start_di" bpmnElement="Note_Start">
        <dc:Bounds x="60" y="78" width="210" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_Catch_di" bpmnElement="Note_Catch">
        <dc:Bounds x="60" y="218" width="210" height="40"/>

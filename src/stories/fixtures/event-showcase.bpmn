        <bpmndi:BPMNLabel><dc:Bounds x="268" y="124" width="100" height="26"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Message_di" bpmnElement="S_Message">

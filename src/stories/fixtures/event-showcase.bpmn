      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Conditional_di" bpmnElement="S_Conditional">
        <dc:Bounds x="660" y="80" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="628" y="124" width="100" height="26"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Signal_di" bpmnElement="S_Signal">
        <dc:Bounds x="780" y="80" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="748" y="124" width="100" height="26"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Multiple_di" bpmnElement="S_Multiple">
        <dc:Bounds x="900" y="80" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="868" y="124" width="100" height="26"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_ParallelMultiple_di" bpmnElement="S_ParallelMultiple">
        <dc:Bounds x="1020" y="80" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="988" y="124" width="100" height="26"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- row 2 -->
      <bpmndi:BPMNShape id="IC_Message_di" bpmnElement="IC_Message">
        <dc:Bounds x="300" y="220" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="268" y="264" width="100" height="26"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IC_Timer_di" bpmnElement="IC_Timer">
        <dc:Bounds x="420" y="220" width="36" height="36"/>

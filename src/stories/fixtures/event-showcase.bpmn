      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IC_Multiple_di" bpmnElement="IC_Multiple">
        <dc:Bounds x="900" y="220" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="868" y="264" width="100" height="26"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IC_ParallelMultiple_di" bpmnElement="IC_ParallelMultiple">

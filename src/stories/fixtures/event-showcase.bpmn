        <bpmndi:BPMNLabel><dc:Bounds x="508" y="544" width="100" height="26"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_Error_di" bpmnElement="E_Error">
        <dc:Bounds x="660" y="500" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="628" y="544" width="100" height="26"/></bpmndi:BPMNLabel>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Executable claims workflow — the code blocks (bsf:script) and the workflow
  tests (bsf:test) live in this file, so it is self-contained, runnable and
  tested. Open it in <BpmnSimulator> and press "Run tests".
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bsf="http://bpmn-svelte-flow/schema/1.0"
    id="Definitions_ExecutableClaims"
    targetNamespace="http://bpmn-svelte-flow/fixtures">

  <bpmn:process id="Process_Claims" isExecutable="true">

    <bpmn:extensionElements>
      <bsf:test name="large claims route to manual review" payload='{"amount": 5200}'>
        assert(state.visited.has('Task_Manual'), 'manual review should run');
        assert(!state.visited.has('Task_Auto'), 'auto-approval must be skipped');
        assert.equal(payload.approvedBy, 'supervisor');
        assert.equal(payload.fee, 25);
      </bsf:test>
      <bsf:test name="small claims auto-approve" payload='{"amount": 120}'>
        assert(state.visited.has('Task_Auto'), 'auto-approval should run');
        assert(!state.visited.has('Task_Manual'), 'no manual review needed');
        assert.equal(payload.risk, 'low');
        assert.equal(payload.approvedBy, 'system');
      </bsf:test>
      <bsf:test name="final payload is stamped and settled" payload='{"amount": 900}'>
        assert.equal(payloads.length, 1, 'exactly one token reaches an end event');
        assert.equal(payload.status, 'settled');
        assert.equal(payload.notified, true);
        assert.equal(payload.amount, 900, 'the initial payload survives the run');
      </bsf:test>
      <bsf:test name="every run visits scoring, notification and the end event" payload='{"amount": 3000}'>
        assert(state.visited.has('Task_Score'), 'claims are always scored');
        assert(state.visited.has('Gw_Amount'), 'routing gateway is always reached');
        assert(state.visited.has('Task_Notify'), 'the claimant is always notified');
        assert(state.visited.has('End_1'), 'the workflow reaches its end event');
        assert(state.finished, 'the workflow completes');
      </bsf:test>
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start_1" name="Claim received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:businessRuleTask id="Task_Score" name="Score claim">
      <bpmn:extensionElements>
        <bsf:script>payload.risk = payload.amount > 1000 ? "high" : "low";</bsf:script>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gw_Amount" name="Large claim?" default="Flow_Auto">
      <bpmn:extensionElements>
        <bsf:script>return payload.risk === "high" ? "Flow_Manual" : "Flow_Auto";</bsf:script>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Auto</bpmn:outgoing>
      <bpmn:outgoing>Flow_Manual</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Auto" name="Auto-approve">
      <bpmn:extensionElements>
        <bsf:script>payload.approvedBy = "system";
payload.fee = 0;</bsf:script>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Auto</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_Manual" name="Manual review">
      <bpmn:extensionElements>
        <bsf:script>payload.approvedBy = "supervisor";
payload.fee = 25;</bsf:script>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gw_Merge">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_Notify" name="Notify claimant">
      <bpmn:extensionElements>
        <bsf:script>payload.notified = true;</bsf:script>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_1" name="Claim settled">
      <bpmn:extensionElements>
        <bsf:script>payload.status = "settled";</bsf:script>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Score"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Score" targetRef="Gw_Amount"/>
    <bpmn:sequenceFlow id="Flow_Auto" name="small" sourceRef="Gw_Amount" targetRef="Task_Auto"/>
    <bpmn:sequenceFlow id="Flow_Manual" name="large" sourceRef="Gw_Amount" targetRef="Task_Manual"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Auto" targetRef="Gw_Merge"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Manual" targetRef="Gw_Merge"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gw_Merge" targetRef="Task_Notify"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Notify" targetRef="End_1"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_Claims">
    <bpmndi:BPMNPlane id="Plane_Claims" bpmnElement="Process_Claims">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="160" y="222" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="128" y="264" width="100" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Score_di" bpmnElement="Task_Score">
        <dc:Bounds x="250" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Amount_di" bpmnElement="Gw_Amount">
        <dc:Bounds x="400" y="215" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="325" y="180" width="92" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Auto_di" bpmnElement="Task_Auto">
        <dc:Bounds x="520" y="120" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Manual_di" bpmnElement="Task_Manual">
        <dc:Bounds x="520" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Merge_di" bpmnElement="Gw_Merge">
        <dc:Bounds x="680" y="215" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Notify_di" bpmnElement="Task_Notify">
        <dc:Bounds x="790" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1">
        <dc:Bounds x="950" y="222" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="918" y="264" width="100" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="196" y="240"/>
        <di:waypoint x="250" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="350" y="240"/>
        <di:waypoint x="400" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Auto_di" bpmnElement="Flow_Auto">
        <di:waypoint x="425" y="215"/>
        <di:waypoint x="425" y="160"/>
        <di:waypoint x="520" y="160"/>
        <bpmndi:BPMNLabel><dc:Bounds x="434" y="134" width="50" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manual_di" bpmnElement="Flow_Manual">
        <di:waypoint x="425" y="265"/>
        <di:waypoint x="425" y="340"/>
        <di:waypoint x="520" y="340"/>
        <bpmndi:BPMNLabel><dc:Bounds x="434" y="314" width="50" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="620" y="160"/>
        <di:waypoint x="705" y="160"/>
        <di:waypoint x="705" y="215"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="620" y="340"/>
        <di:waypoint x="705" y="340"/>
        <di:waypoint x="705" y="265"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="730" y="240"/>
        <di:waypoint x="790" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="890" y="240"/>
        <di:waypoint x="950" y="240"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

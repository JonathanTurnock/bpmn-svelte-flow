<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bsf="http://bpmn-svelte-flow/schema/1.0"
    id="Defs_Messaging"
    expressionLanguage="text/javascript"
    targetNamespace="http://acme.dev/messaging-poc">

  <bpmn:collaboration id="Collab_Messaging">
    <bpmn:participant id="Part_Platform" name="Messaging Platform" processRef="P_Messaging"/>
  </bpmn:collaboration>

  <bpmn:message id="Msg_ApiRequest" name="api-request"/>
  <bpmn:message id="Msg_KinesisRecord" name="kinesis-record">
    <bpmn:extensionElements>
      <bsf:sample correlationKey="chatId">{"kinesis":{"stream":"chat-messages-v1","partitionKey":"chat_8231","sequenceNumber":"49590338271490256608559692538361571095921575989136588898"}}</bsf:sample>
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Err_PolicyDenied" name="PolicyDenied" errorCode="POLICY_DENIED"/>

  <bpmn:process id="P_Messaging" isExecutable="true">
    <bpmn:extensionElements>
      <bsf:scenario name="Happy path" payload='{"senderId":"usr_1042","text":"Paying with card 4111 1111 1111 1111, CVV: 737 — ok?","chatId":"chat_8231"}'/>
      <bsf:scenario name="Policy denied" payload='{"senderId":"usr_6660","text":"hey — card 4111 1111 1111 1111","chatId":"chat_8231","muted":true}'/>
      <bsf:test name="pan is redacted before anything else" payload='{"senderId":"usr_1042","text":"card 4111 1111 1111 1111","chatId":"chat_8231"}'>
        assert(payload.text.indexOf('4111 1111') === -1, 'raw PAN must not survive');
      </bsf:test>
      <bsf:test name="muted senders are rejected" payload='{"senderId":"usr_6660","text":"x","chatId":"chat_8231","muted":true}'>
        assert(state.visited.has('End_Rejected'));
        assert(!state.visited.has('Task_Save'), 'nothing persists on deny');
      </bsf:test>
      <bsf:test name="deliveries fan out per participant" payload='{"senderId":"usr_1042","text":"hi","chatId":"chat_8231"}'>
        assert.equal(payload.deliveries.length, 2);
        assert.equal(payload.deliveries[0].channel, 'kafka');
        assert.equal(payload.deliveries[1].channel, 'webhook');
      </bsf:test>
    </bpmn:extensionElements>

    <bpmn:laneSet id="Lanes_1">
      <bpmn:lane id="Lane_API" name="Ingress API">
        <bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sanitise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Policy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Save</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Stream" name="Stream Processor">
        <bpmn:flowNodeRef>Catch_Kinesis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Participants</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Delivery" name="Delivery">
        <bpmn:flowNodeRef>Sub_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Request" name="API request received">
      <bpmn:documentation>POST /v1/chats/{chatId}/messages. Bearer token resolves senderId. Body: { senderId, text, sentAt }.</bpmn:documentation>
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Start" messageRef="Msg_ApiRequest"/>
    </bpmn:startEvent>

    <bpmn:scriptTask id="Task_Sanitise" name="Sanitise payload (PII / PAN redaction)" scriptFormat="text/javascript">
      <bpmn:documentation>Regex security filters over every inbound field: PAN (13-16 digits), CVV, IBAN. Every hit recorded to security.redactions for audit. Runs BEFORE policy so rejected messages never carry raw PANs into logs.</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:script>
        const redactions = [];
        let text = payload.text;
        const pan = /\b(?:\d[ -]?){12}(?:\d[ -]?){1,3}\d\b/g;
        if (pan.test(text)) {
          text = text.replace(pan, (m) =&gt; '•••• •••• •••• ' + m.replace(/\D/g, '').slice(-4));
          redactions.push({ filter: 'pan', count: 1 });
        }
        const cvv = /\b[Cc][Vv][Vv2]*\s*:?\s*\d{3,4}\b/g;
        if (cvv.test(text)) {
          text = text.replace(cvv, 'CVV: •••');
          redactions.push({ filter: 'cvv', count: 1 });
        }
        payload.text = text;
        payload.security = { redactions };
      </bpmn:script>
    </bpmn:scriptTask>

    <bpmn:businessRuleTask id="Task_Policy" name="Evaluate Cedar policy">
      <bpmn:documentation>Cedar: permit SendMessage when principal in chat.members and not principal.muted; forbid when principal.muted. Forbid overrides permit. Decision + determining policy recorded for audit.</bpmn:documentation>
      <bpmn:extensionElements>
        <bsf:binding type="decision">
          <bsf:property name="policyStore" value="messaging-policies"/>
        </bsf:binding>
        <bsf:mock>
          payload.policy = payload.muted
            ? { decision: 'DENY', determiningPolicy: 'forbid-muted-senders' }
            : { decision: 'ALLOW', determiningPolicy: 'permit-chat-members' };
        </bsf:mock>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="GW_Allowed" name="Allowed?" default="F_Deny">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F_Allow</bpmn:outgoing>
      <bpmn:outgoing>F_Deny</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_Rejected" name="403 rejected">
      <bpmn:documentation>HTTP 403 { error: policy_denied, policy, reason }. Nothing persisted; nothing reaches the stream.</bpmn:documentation>
      <bpmn:incoming>F_Deny</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrDef_Rejected" errorRef="Err_PolicyDenied"/>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Save" name="Save message (Messages API)">
      <bpmn:documentation>POST internal.messages-api /v1/messages with the sanitised, authorised message. 201 → { messageId, persistedAt }. The Messages API owns durability and emits to Kinesis after commit.</bpmn:documentation>
      <bpmn:extensionElements>
        <bsf:binding type="http">
          <bsf:property name="method" value="POST"/>
          <bsf:property name="url" value="https://internal.messages-api/v1/messages"/>
        </bsf:binding>
        <bsf:mock>payload.messagesApi = { status: 201, messageId: 'msg_5f2e9c' };</bsf:mock>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Allow</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:intermediateCatchEvent id="Catch_Kinesis" name="Kinesis record arrives">
      <bpmn:documentation>Async boundary. Consumer: messaging-fanout (KCL, stream chat-messages-v1, partitionKey = chatId for per-chat ordering). The HTTP request context is gone; execution resumes from the stream record.</bpmn:documentation>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Kinesis" messageRef="Msg_KinesisRecord"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:scriptTask id="Task_Join" name="Join record with original request context" scriptFormat="text/javascript">
      <bpmn:documentation>The record carries ids only. Re-hydrate sanitised text + audit trail from the ingress context cache (PUT request-context/{messageId}, TTL 15m). Record wins on conflict.</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:script>
        payload.message = {
          messageId: payload.messagesApi.messageId,
          chatId: payload.chatId,
          senderId: payload.senderId,
          text: payload.text
        };
      </bpmn:script>
    </bpmn:scriptTask>

    <bpmn:serviceTask id="Task_Participants" name="Fetch chat participants">
      <bpmn:documentation>GET internal.chats-api /v1/chats/{chatId}/participants. Sender excluded. Each participant carries a resolved deliveryMethod: kafka (internal consumers) or webhook (per-tenant registered endpoint).</bpmn:documentation>
      <bpmn:extensionElements>
        <bsf:binding type="http">
          <bsf:property name="method" value="GET"/>
          <bsf:property name="url" value="https://internal.chats-api/v1/chats/{chatId}/participants"/>
        </bsf:binding>
        <bsf:mock>
          payload.participants = [
            { id: 'usr_2001', deliveryMethod: 'kafka' },
            { id: 'usr_2002', deliveryMethod: 'webhook' }
          ];
        </bsf:mock>
      </bpmn:extensionElements>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:subProcess id="Sub_Deliver" name="Deliver to each participant">
      <bpmn:documentation>Runs once per participant. Delivery method routes to a keyed Kafka record or a signed webhook call.</bpmn:documentation>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics id="MI_Deliver" isSequential="true">
        <bpmn:extensionElements>
          <bsf:collection expression="participants" elementVariable="participant"/>
        </bpmn:extensionElements>
        <bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">payload.participants.length</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="Sub_Start" name="Per participant">
        <bpmn:outgoing>FS1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="GW_Method" name="Delivery method?" default="F_W">
        <bpmn:incoming>FS1</bpmn:incoming>
        <bpmn:outgoing>F_K</bpmn:outgoing>
        <bpmn:outgoing>F_W</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="Task_Kafka" name="Publish Kafka message">
        <bpmn:documentation>topic chat-message-deliveries, key = participant.id (per-recipient ordering), acks=all, idempotent producer.</bpmn:documentation>
        <bpmn:extensionElements>
          <bsf:binding type="kafka-producer">
            <bsf:property name="topic" value="chat-message-deliveries"/>
          </bsf:binding>
          <bsf:mock>
            payload.deliveries = (payload.deliveries || []).concat({
              channel: 'kafka', recipient: payload.participant.id, topic: 'chat-message-deliveries'
            });
          </bsf:mock>
        </bpmn:extensionElements>
        <bpmn:incoming>F_K</bpmn:incoming>
        <bpmn:outgoing>F_K2</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:serviceTask id="Task_Webhook" name="Call webhook endpoint">
        <bpmn:documentation>Per-tenant endpoint, HMAC-SHA256 signed body, exponential backoff ×5 then dead-letter.</bpmn:documentation>
        <bpmn:extensionElements>
          <bsf:binding type="http">
            <bsf:property name="method" value="POST"/>
            <bsf:property name="url" value="{participant.webhookUrl}"/>
          </bsf:binding>
          <bsf:mock>
            payload.deliveries = (payload.deliveries || []).concat({
              channel: 'webhook', recipient: payload.participant.id, status: 202
            });
          </bsf:mock>
        </bpmn:extensionElements>
        <bpmn:incoming>F_W</bpmn:incoming>
        <bpmn:outgoing>F_W2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_Kafka" name="Queued">
        <bpmn:incoming>F_K2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_Webhook" name="Notified">
        <bpmn:incoming>F_W2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="FS1" sourceRef="Sub_Start" targetRef="GW_Method"/>
      <bpmn:sequenceFlow id="F_K" name="kafka" sourceRef="GW_Method" targetRef="Task_Kafka">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/javascript">payload.participant.deliveryMethod === "kafka"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F_W" name="webhook" sourceRef="GW_Method" targetRef="Task_Webhook"/>
      <bpmn:sequenceFlow id="F_K2" sourceRef="Task_Kafka" targetRef="End_Kafka"/>
      <bpmn:sequenceFlow id="F_W2" sourceRef="Task_Webhook" targetRef="End_Webhook"/>
    </bpmn:subProcess>

    <bpmn:endEvent id="End_Done" name="All deliveries dispatched">
      <bpmn:documentation>deliveries[] is the contract this flow guarantees downstream.</bpmn:documentation>
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F1" sourceRef="Start_Request" targetRef="Task_Sanitise"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Sanitise" targetRef="Task_Policy"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Policy" targetRef="GW_Allowed"/>
    <bpmn:sequenceFlow id="F_Allow" name="allow" sourceRef="GW_Allowed" targetRef="Task_Save">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/javascript">payload.policy.decision === "ALLOW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Deny" name="deny" sourceRef="GW_Allowed" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="F5" name="await propagation" sourceRef="Task_Save" targetRef="Catch_Kinesis"/>
    <bpmn:sequenceFlow id="F6" sourceRef="Catch_Kinesis" targetRef="Task_Join"/>
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Join" targetRef="Task_Participants"/>
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Participants" targetRef="Sub_Deliver"/>
    <bpmn:sequenceFlow id="F9" sourceRef="Sub_Deliver" targetRef="End_Done"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_Messaging">
    <bpmndi:BPMNPlane id="Plane_Messaging" bpmnElement="Collab_Messaging">
      <bpmndi:BPMNShape id="Part_Platform_di" bpmnElement="Part_Platform" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="1060" height="640"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_API_di" bpmnElement="Lane_API" isHorizontal="true">
        <dc:Bounds x="70" y="40" width="1030" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Stream_di" bpmnElement="Lane_Stream" isHorizontal="true">
        <dc:Bounds x="70" y="240" width="1030" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Delivery_di" bpmnElement="Lane_Delivery" isHorizontal="true">
        <dc:Bounds x="70" y="400" width="1030" height="280"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Request_di" bpmnElement="Start_Request">
        <dc:Bounds x="112" y="122" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="100" y="166" width="88" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Sanitise_di" bpmnElement="Task_Sanitise">
        <dc:Bounds x="190" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Policy_di" bpmnElement="Task_Policy">
        <dc:Bounds x="340" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Allowed_di" bpmnElement="GW_Allowed" isMarkerVisible="true">
        <dc:Bounds x="490" y="115" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected">
        <dc:Bounds x="603" y="48" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Save_di" bpmnElement="Task_Save">
        <dc:Bounds x="600" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_Kinesis_di" bpmnElement="Catch_Kinesis">
        <dc:Bounds x="632" y="282" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Join_di" bpmnElement="Task_Join">
        <dc:Bounds x="730" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Participants_di" bpmnElement="Task_Participants">
        <dc:Bounds x="880" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_Deliver_di" bpmnElement="Sub_Deliver" isExpanded="true">
        <dc:Bounds x="160" y="430" width="650" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_Start_di" bpmnElement="Sub_Start">
        <dc:Bounds x="190" y="522" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="160" y="564" width="96" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Method_di" bpmnElement="GW_Method" isMarkerVisible="true">
        <dc:Bounds x="260" y="515" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="237" y="461" width="96" height="24"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Kafka_di" bpmnElement="Task_Kafka">
        <dc:Bounds x="400" y="450" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Webhook_di" bpmnElement="Task_Webhook">
        <dc:Bounds x="400" y="555" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Kafka_di" bpmnElement="End_Kafka">
        <dc:Bounds x="562" y="472" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Webhook_di" bpmnElement="End_Webhook">
        <dc:Bounds x="562" y="577" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Done_di" bpmnElement="End_Done">
        <dc:Bounds x="880" y="522" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="148" y="140"/><di:waypoint x="190" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="290" y="140"/><di:waypoint x="340" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="440" y="140"/><di:waypoint x="490" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Allow_di" bpmnElement="F_Allow"><di:waypoint x="540" y="140"/><di:waypoint x="600" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Deny_di" bpmnElement="F_Deny"><di:waypoint x="515" y="115"/><di:waypoint x="515" y="66"/><di:waypoint x="603" y="66"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="650" y="180"/><di:waypoint x="650" y="282"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="668" y="300"/><di:waypoint x="730" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="830" y="300"/><di:waypoint x="880" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="930" y="340"/><di:waypoint x="930" y="412"/><di:waypoint x="485" y="412"/><di:waypoint x="485" y="430"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FS1_di" bpmnElement="FS1"><di:waypoint x="226" y="540"/><di:waypoint x="260" y="540"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_K_di" bpmnElement="F_K"><di:waypoint x="285" y="515"/><di:waypoint x="285" y="490"/><di:waypoint x="400" y="490"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_W_di" bpmnElement="F_W"><di:waypoint x="285" y="565"/><di:waypoint x="285" y="595"/><di:waypoint x="400" y="595"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_K2_di" bpmnElement="F_K2"><di:waypoint x="500" y="490"/><di:waypoint x="562" y="490"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_W2_di" bpmnElement="F_W2"><di:waypoint x="500" y="595"/><di:waypoint x="562" y="595"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="810" y="540"/><di:waypoint x="880" y="540"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
